# --- OCR Client Worker Configuration ----------------------------------
# URL ของ Image Store Server
IMAGE_STORE_BASE_URL=https://cfo.ntplc.co.th/iot
IMAGE_STORE_VERIFY_TLS=true

# API Key สำหรับ OCR Worker (X-OCR-Key)
OCR_API_KEY=

# วนลูปเช็คงานใหม่ทุกกี่วินาที
POLL_INTERVAL_SECONDS=10

# ดึงงานมาทำครั้งละกี่งานต่อรอบ
BATCH_SIZE=20

# Gemini API Key & Model (สำหรับเป็น Fallback เมื่ออ่านไม่ออก)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# (ทางเลือก) Endpoint ปลายทางสำหรับตาราง Test (เมื่อ Server พร้อม)
# API_SUBMIT_RESULT_TEST=/admin/images/ocr/{job_id}/result-test
