# URL ของ Server ที่เพื่อนเปิดไว้ (เช่น https://192.168.1.50:8443 หรือ https://localhost:8443)
IMAGE_STORE_BASE_URL=https://localhost:8443
IMAGE_STORE_VERIFY_TLS=false

# บัญชีสำหรับเชื่อมต่อ Server
OCR_SERVICE_USERNAME=ocr-service
OCR_SERVICE_PASSWORD=your_password_here

# ความถี่ในการถามหางานใหม่ (วินาที)
POLL_INTERVAL_SECONDS=10
BATCH_SIZE=5

# Gemini API Key (สำหรับกรณี Local AI อ่านไม่ผ่าน)
GEMINI_API_KEY=AQ.Ab8RN6LM3BYwtLAAp_t7-0h8xCTyeHvyKRlXjCXlZkjo54Fi-A
